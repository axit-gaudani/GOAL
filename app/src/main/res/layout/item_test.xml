<?xml version="1.0" encoding="utf-8"?>
<!-- A practice test row: band badge, title, Gujarati title, status line, chevron/lock (as in the design). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/textBand"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/g3_bg_badge14"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textTitleGu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gujarati_text"
                android:textSize="13sp" />

            <!-- Unlocked: best band or "not tried yet" (blue) -->
            <TextView
                android:id="@+id/textBest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <!-- Locked: which level opens it (grey) -->
            <TextView
                android:id="@+id/textLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iconLock"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/status_locked"
            android:src="@drawable/ic_lock"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/iconChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
