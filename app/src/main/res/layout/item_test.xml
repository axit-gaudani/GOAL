<?xml version="1.0" encoding="utf-8"?>
<!-- A practice test row: band badge, title, status, chevron/lock (as in the design). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/textBand"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_badge"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textTitleGu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Gujarati"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textBest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iconLock"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/status_locked"
            android:src="@drawable/ic_lock"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/iconChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
