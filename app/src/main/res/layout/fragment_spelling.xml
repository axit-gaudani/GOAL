<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/g4_screen_side"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <!-- Game switcher pills (same as Match pairs) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeMatch"
                style="@style/G4.Button.Flat"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="@font/inter_semibold"
                android:insetTop="6dp"
                android:insetBottom="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/game_match"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:backgroundTint="@color/surface"
                app:cornerRadius="100dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeSpelling"
                style="@style/G4.Button.Flat"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:insetTop="6dp"
                android:insetBottom="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/game_spelling"
                android:textColor="@color/g4_on_color"
                android:textSize="13sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="100dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textEmpty"
            style="@style/G4.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/game_needs_words"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/groupGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCounter"
                style="@style/G4.Text.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/G4.Text.Instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/spelling_title" />

            <TextView
                style="@style/G4.Text.Gu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/spelling_title_gu" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListen"
                    style="@style/G4.Button.Flat"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_listen"
                    android:textColor="@color/g4_on_color"
                    app:backgroundTint="@color/g4_teal"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_g4_speaker"
                    app:iconGravity="textStart"
                    app:iconTint="@color/g4_on_color" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSlow"
                    style="@style/G4.Button.Flat"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_slow"
                    android:textColor="@color/g4_teal_text"
                    app:backgroundTint="@color/g4_teal_soft"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/g4_bg_variant_16"
                android:lineSpacingExtra="5dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="@color/gujarati_text"
                android:textSize="15sp" />

            <TextView
                style="@style/G4.Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/inputAnswer"
                android:text="@string/g4_label_your_spelling" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/brand_primary"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:hint="@string/type_the_word"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Feedback: green when right, red when wrong -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/g4_green_soft"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/textFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extrabold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/textCorrectWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textColor="@color/brand_primary"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/textExample"
                        style="@style/G4.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAction"
                style="@style/G4.Button.Big"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/g4_btn_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupFinished"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textFinished"
                style="@style/G4.Text.Instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgain"
                style="@style/G4.Button.Big"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_play_again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/G4.Button.Big"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_done"
                android:textColor="@color/brand_on_primary_container"
                android:textSize="16sp"
                app:backgroundTint="@color/brand_primary_container" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
