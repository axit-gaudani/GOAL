<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Partner header: white bar with a bottom line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/g4_screen_side"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/textAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/g4_bg_circle_teal_soft"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:textColor="@color/g4_teal_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPartner"
                style="@style/G4.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textTitle"
                style="@style/G4.Text.Gu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/g4_divider" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textChoose"
                style="@style/G4.Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/g4_choose_and_say"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- The picked answer, ready to say -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/brand_primary_container"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/brand_primary"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="@string/now_say_it"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textSay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/brand_on_primary_container"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textSayGu"
                            style="@style/G4.Text.Gu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnListenAnswer"
                        style="@style/G4.Button.Circle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/cd_play"
                        app:backgroundTint="@color/surface"
                        app:icon="@drawable/ic_g4_speaker"
                        app:iconSize="20dp"
                        app:iconTint="@color/g4_teal_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/groupFinished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/G4.Text.Instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/conversation_done" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    style="@style/G4.Button.Big"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_done" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom controls: Gujarati hint · Say it · hear again -->
    <LinearLayout
        android:id="@+id/groupControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/g4_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/g4_screen_side"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHint"
                style="@style/G4.Button.Circle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_gujarati_hint"
                android:fontFamily="@font/inter_extrabold"
                android:text="@string/gu_short"
                android:textColor="@color/g4_amber_text"
                android:textSize="15sp"
                app:backgroundTint="@color/g4_amber_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeak"
                style="@style/G4.Button.Flat"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:text="@string/btn_say_it"
                android:textColor="@color/g4_on_color"
                android:textSize="16sp"
                app:backgroundTint="@color/g4_record"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_g4_mic"
                app:iconGravity="textStart"
                app:iconSize="22dp"
                app:iconTint="@color/g4_on_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplay"
                style="@style/G4.Button.Circle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_replay"
                app:backgroundTint="@color/g4_teal_soft"
                app:icon="@drawable/ic_g4_speaker"
                app:iconSize="20dp"
                app:iconTint="@color/g4_teal_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
