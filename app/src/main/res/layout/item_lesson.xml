<?xml version="1.0" encoding="utf-8"?>
<!-- One lesson of a level, in the same compact card style as the learning path:
     40dp number dot, bold title, Gujarati line, meta + status, 18dp card (blue border on the next lesson). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/track"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/textLessonNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_soft"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textLessonTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_extrabold"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textLessonTitleGu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gujarati_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textLessonMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textLessonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/brand_on_primary_container"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iconStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:tint="@color/brand_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
