<?xml version="1.0" encoding="utf-8"?>
<!-- Topic pack tile (2 per row). The chosen pack gets a blue border. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:checkedIcon="@null"
    app:strokeColor="@color/g4_pack_stroke"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textTitle"
                style="@style/G4.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:maxLines="1"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iconLock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/status_locked"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textIelts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/g4_bg_ielts_tag"
                android:fontFamily="@font/inter_extrabold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="@string/ielts_tag"
                android:textColor="@color/brand_on_primary_container"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTitleGu"
            style="@style/G4.Text.Gu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textCount"
            style="@style/G4.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="11sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            app:indicatorColor="@color/brand_primary"
            app:trackColor="@color/track"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
