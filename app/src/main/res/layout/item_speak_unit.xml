<?xml version="1.0" encoding="utf-8"?>
<!-- Speaking unit row. Colours by state are set in code: done = white + green badge,
     current = white with teal border, locked = grey. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/g4_teal"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp">

        <TextView
            android:id="@+id/textNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:textColor="@color/g4_on_color"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                style="@style/G4.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textTitleGu"
                style="@style/G4.Text.Gu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMeta"
            style="@style/G4.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
