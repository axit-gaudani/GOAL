<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="2dp"
        android:paddingBottom="24dp">

        <!-- The toolbar shows "Sentence practice"; the Gujarati line sits under it -->
        <TextView
            style="@style/G4.Text.Gu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/g4_sentence_hub_sub"
            android:textSize="14sp" />

        <!-- Today's round -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/g4_hero"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/g4_on_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/g4_bg_amber_pill"
                        android:fontFamily="@font/inter_bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/g4_amber_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/g4_round_title"
                    android:textColor="@color/g4_on_color"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/textRoundMix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/g4_on_color"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    style="@style/Widget.App.Button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_start_round"
                    android:textColor="@color/g4_hero_btn_text"
                    android:textSize="17sp"
                    app:backgroundTint="@color/g4_hero_btn_bg"
                    app:icon="@drawable/ic_g4_play_solid"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/g4_hero_btn_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Grammar patterns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                style="@style/G4.Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/g4_grammar_patterns" />

            <TextView
                style="@style/G4.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/g4_weakest_first" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/textNoPatterns"
                    style="@style/G4.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_patterns_yet"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/patternsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Single skills, 2 columns -->
        <TextView
            style="@style/G4.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/practise_one_skill" />

        <LinearLayout
            android:id="@+id/modesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
