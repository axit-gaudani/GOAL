<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/groupPhrase"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Progress row (the toolbar already has the back arrow, so the close button stays hidden) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/g4_screen_side">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_close"
                android:visibility="gone"
                app:icon="@drawable/ic_close" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="@color/brand_tertiary"
                app:trackColor="@color/track"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <TextView
                android:id="@+id/textCounter"
                style="@style/G4.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:minWidth="40dp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/g4_screen_side"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/textUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAllCaps="true"
                    android:textColor="@color/g4_teal_label"
                    android:textSize="13sp" />

                <TextView
                    style="@style/G4.Text.Instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/g4_listen_then_say" />

                <TextView
                    style="@style/G4.Text.Gu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/g4_listen_then_say_gu" />

                <!-- Phrase card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/textPhrase"
                            style="@style/G4.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_extrabold"
                            android:lineSpacingExtra="8dp"
                            android:textSize="26sp" />

                        <TextView
                            android:id="@+id/textPron"
                            style="@style/G4.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/textGu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/gujarati_text"
                            android:textSize="17sp" />

                        <TextView
                            style="@style/G4.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/stress_hint" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Teacher · Slow · My voice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTeacher"
                        style="@style/G4.Button.Flat"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1.2"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_teacher"
                        android:textColor="@color/g4_teal_text"
                        app:backgroundTint="@color/g4_teal_soft"
                        app:icon="@drawable/ic_g4_speaker"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/g4_teal_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSlow"
                        style="@style/G4.Button.Flat"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="5dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="6dp"
                        android:text="@string/btn_slow"
                        android:textColor="@color/g4_teal_text"
                        app:backgroundTint="@color/g4_teal_soft" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMyVoice"
                        style="@style/G4.Button.Flat"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1.2"
                        android:enabled="false"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_my_voice"
                        android:textColor="@color/g4_amber_text"
                        app:backgroundTint="@color/g4_amber_soft"
                        app:icon="@drawable/ic_g4_play_solid"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/g4_amber_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textNoCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/g4_bg_variant_16"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="@string/no_speech_check"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- What the phone heard -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHeard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/g4_green_soft"
                    app:cardCornerRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textHeardLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/g4_we_heard"
                                android:textColor="@color/g4_green_text"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textHeardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textHeard"
                            style="@style/G4.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textHeardCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/g4_green_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Big red record button with a soft halo, then Say & check + Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/g4_screen_side"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:background="@drawable/g4_bg_circle_halo">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecord"
                    style="@style/G4.Button.Circle"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_record"
                    app:backgroundTint="@color/g4_record"
                    app:icon="@drawable/ic_g4_mic"
                    app:iconSize="36dp"
                    app:iconTint="@color/g4_on_color" />
            </FrameLayout>

            <TextView
                android:id="@+id/textRecordHint"
                style="@style/G4.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/g4_tap_to_record"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheck"
                    style="@style/G4.Button.Flat"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_say_check"
                    android:textColor="@color/g4_record"
                    android:textSize="16sp"
                    app:backgroundTint="@color/g4_record_halo"
                    app:icon="@drawable/ic_g4_mic"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/g4_record" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/G4.Button.Flat"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/btn_next_phrase"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupFinished"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/g4_bg_circle_green"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/ic_g4_check"
            app:tint="@color/g4_on_color" />

        <TextView
            android:id="@+id/textFinished"
            style="@style/G4.Text.Instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToChat"
            style="@style/G4.Button.Big"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_to_conversation"
            app:icon="@drawable/ic_chat"
            app:iconGravity="textStart" />
    </LinearLayout>
</FrameLayout>
