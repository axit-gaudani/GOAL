<?xml version="1.0" encoding="utf-8"?>
<!-- One test question (design: TimedTest.dc.html). TFNG/YNNG = 3 pills, MCQ = radios, FILL = small box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textGroupHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/g3_bg_soft12"
        android:fontFamily="@font/inter_bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/brand_on_primary_container"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_soft"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textWordLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/g3_amber_text"
        android:textSize="12sp" />

    <!-- TRUE / FALSE / NOT GIVEN (or YES / NO / NOT GIVEN) pills, added in code -->
    <LinearLayout
        android:id="@+id/groupPills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <!-- Multiple choice options, added in code -->
    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp" />

    <!-- Fill-in answer box -->
    <FrameLayout
        android:id="@+id/inputLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/inputAnswer"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:background="@drawable/g3_bg_input"
            android:hint="@string/answer_hint"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
