<?xml version="1.0" encoding="utf-8"?>
<!-- One step of the learning path, drawn as a vertical timeline (dot + line + card), as in the Path artboard:
     40dp dot (green = done, blue with a 5dp soft-blue halo = current, grey = locked), 3dp line, compact 18dp card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="match_parent">

        <!-- Line above the dot (coloured by the previous level) -->
        <View
            android:id="@+id/lineUp"
            android:layout_width="3dp"
            android:layout_height="25dp"
            android:layout_gravity="center_horizontal|top"
            android:background="@color/track" />

        <!-- Line below the dot (green when this level is done) -->
        <View
            android:id="@+id/lineDown"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp"
            android:background="@color/track" />

        <FrameLayout
            android:id="@+id/dotHalo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="top|center_horizontal">

            <TextView
                android:id="@+id/textLevelNumber"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary"
                android:fontFamily="@font/inter_extrabold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </FrameLayout>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="7dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/track"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textLevelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <!-- Kept for older code paths; the dot shows the state, as in the design. -->
                <ImageView
                    android:id="@+id/iconLock"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/status_locked"
                    android:src="@drawable/ic_lock"
                    android:visibility="gone"
                    app:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/iconDone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/g2_correct" />

                <TextView
                    android:id="@+id/textLevelBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_bold"
                    android:maxWidth="150dp"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/brand_on_primary_container"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textLevelTitleGu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gujarati_text"
                android:textSize="14sp" />

            <!-- Not shown in the design's compact rows; kept for the id. -->
            <TextView
                android:id="@+id/textLevelDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.Secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/groupProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="@color/brand_primary"
                    app:trackColor="@color/track"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/textLevelProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
