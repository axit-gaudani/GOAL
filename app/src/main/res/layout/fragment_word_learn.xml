<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/groupCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- "Environment · new word 2 of 5" + thin progress line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/g4_screen_side">

            <TextView
                android:id="@+id/textCounter"
                style="@style/G4.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textSize="15sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/brand_tertiary"
                app:trackColor="@color/track"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/g4_screen_side"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- Word card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textWord"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_extrabold"
                                    android:textColor="@color/brand_primary"
                                    android:textSize="34sp" />

                                <TextView
                                    android:id="@+id/textPos"
                                    style="@style/G4.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlay"
                                style="@style/G4.Button.Circle"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/cd_play"
                                app:backgroundTint="@color/g4_teal"
                                app:icon="@drawable/ic_g4_speaker"
                                app:iconSize="24dp"
                                app:iconTint="@color/g4_on_color" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textMeaningGu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/gujarati_text"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/textMeaningEn"
                            style="@style/G4.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textExample"
                                    style="@style/G4.Text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:lineSpacingExtra="6dp"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/textExampleGu"
                                    style="@style/G4.Text.Gu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlayExample"
                                style="@style/G4.Button.Circle"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/g4_cd_play_sentence"
                                app:backgroundTint="@color/g4_teal_soft"
                                app:icon="@drawable/ic_g4_speaker"
                                app:iconSize="20dp"
                                app:iconTint="@color/g4_teal_text" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/textFamilyHeader"
                    style="@style/G4.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/word_family"
                    android:textSize="15sp" />

                <!-- Word forms, 3 per row (built in code) -->
                <LinearLayout
                    android:id="@+id/familyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">

                        <LinearLayout
                            android:id="@+id/rowSynonyms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="92dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/same_meaning"
                                android:textColor="@color/g4_green"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textSynonyms"
                                style="@style/G4.Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowOpposites"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="92dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/opposite"
                                android:textColor="@color/g4_red"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textOpposites"
                                style="@style/G4.Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowCollocations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="92dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/goes_with"
                                android:textColor="@color/brand_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textCollocations"
                                style="@style/G4.Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/textIeltsTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/g4_bg_variant_16"
                    android:lineSpacingExtra="5dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/gujarati_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/g4_screen_side"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKnow"
                style="@style/G4.Button.Flat"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/btn_i_know_this"
                android:textColor="@color/brand_on_primary_container"
                app:backgroundTint="@color/brand_primary_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLearn"
                style="@style/G4.Button.Flat"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/btn_learn_word" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupFinished"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/g4_bg_circle_green"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/ic_g4_check"
            app:tint="@color/g4_on_color" />

        <TextView
            android:id="@+id/textFinished"
            style="@style/G4.Text.Instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            style="@style/G4.Button.Big"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_done" />
    </LinearLayout>
</FrameLayout>
