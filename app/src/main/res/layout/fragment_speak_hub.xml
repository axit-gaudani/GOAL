<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/g4_screen_side"
        android:paddingTop="2dp"
        android:paddingBottom="20dp">

        <!-- The toolbar shows the title; the Gujarati line sits under it -->
        <TextView
            style="@style/G4.Text.Gu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/g4_speak_hub_sub" />

        <!-- Phrase of the day -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/g4_teal"
            app:cardCornerRadius="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/phrase_of_day"
                    android:textColor="@color/g4_on_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textPhrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:textColor="@color/g4_on_color"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/textPhrasePron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.85"
                    android:textColor="@color/g4_on_color"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textPhraseGu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/g4_on_color"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPhraseListen"
                        style="@style/G4.Button.Flat"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/btn_listen"
                        android:textColor="@color/g4_teal_text"
                        android:textSize="14sp"
                        app:backgroundTint="@color/g4_hero_btn_bg"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_g4_speaker"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/g4_teal_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPhraseSay"
                        style="@style/G4.Button.Flat"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/btn_say_it"
                        android:textColor="@color/g4_on_color"
                        android:textSize="14sp"
                        app:backgroundTint="@color/g4_white_18"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_g4_mic"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/g4_on_color" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G4.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/speaking_units" />

        <LinearLayout
            android:id="@+id/unitsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
