<?xml version="1.0" encoding="utf-8"?>
<!-- Placement option card: blue 2.5dp border when selected, grey 1.5dp border otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <stroke android:width="2.5dp" android:color="@color/brand_primary"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <stroke android:width="1.5dp" android:color="@color/option_stroke"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
