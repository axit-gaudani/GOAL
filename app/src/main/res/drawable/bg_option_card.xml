<?xml version="1.0" encoding="utf-8"?>
<!-- Card-style choice: blue border when selected, grey border otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <stroke android:width="2.5dp" android:color="@color/brand_primary"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <stroke android:width="1.5dp" android:color="@color/option_stroke"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
